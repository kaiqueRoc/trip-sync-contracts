{
  "openapi": "3.1.0",
  "info": {
    "title": "TripSync API",
    "version": "2.0.0",
    "description": "B2C flight booking API — schema-first contracts from Zod (@trip-sync/contracts).",
    "contact": {
      "name": "Kaique Rocha",
      "url": "https://github.com/kaiqueRoc"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Local development"
    },
    {
      "url": "https://api.example.tripsync.dev",
      "description": "Staging (placeholder)"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and metadata"
    },
    {
      "name": "Auth",
      "description": "Traveler account and login"
    },
    {
      "name": "Flights",
      "description": "Mocked flight search and seat maps"
    },
    {
      "name": "Payments",
      "description": "Mocked payment processing"
    },
    {
      "name": "Bookings",
      "description": "Ticket issuance lifecycle"
    },
    {
      "name": "Providers",
      "description": "REST/SOAP integration partners"
    },
    {
      "name": "Sync",
      "description": "Async provider synchronization"
    },
    {
      "name": "Webhooks",
      "description": "Inbound provider events"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string",
            "description": "API semantic version"
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "skipped"
                ]
              }
            },
            "required": [
              "database",
              "redis"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checks"
        ]
      },
      "CabinClass": {
        "type": "string",
        "enum": [
          "ECONOMY",
          "PREMIUM",
          "BUSINESS"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "CONFIRMED",
          "CANCELLED"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "reference": {
            "type": "string",
            "pattern": "^BK-[A-Z0-9]{8}$",
            "description": "Human-readable ticket locator"
          },
          "passengerName": {
            "type": "string"
          },
          "passengerDocument": {
            "type": "string"
          },
          "passengerEmail": {
            "type": "string",
            "format": "email"
          },
          "airline": {
            "type": "string"
          },
          "flightNumber": {
            "type": "string"
          },
          "originAirport": {
            "type": "string"
          },
          "destinationAirport": {
            "type": "string"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalAt": {
            "type": "string",
            "format": "date-time"
          },
          "cabinClass": {
            "$ref": "#/components/schemas/CabinClass"
          },
          "seatNumber": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "userId": {
            "type": [
              "string",
              "null"
            ]
          },
          "providerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "cuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reference",
          "passengerName",
          "passengerDocument",
          "passengerEmail",
          "airline",
          "flightNumber",
          "originAirport",
          "destinationAirport",
          "departureAt",
          "arrivalAt",
          "cabinClass",
          "seatNumber",
          "amountCents",
          "currency",
          "status",
          "userId",
          "providerId",
          "createdAt",
          "updatedAt"
        ]
      },
      "BookingListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingResponse"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "pageSize": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "totalItems": {
                "type": "integer",
                "minimum": 0
              },
              "totalPages": {
                "type": "integer",
                "minimum": 0
              },
              "hasNext": {
                "type": "boolean"
              },
              "hasPrev": {
                "type": "boolean"
              }
            },
            "required": [
              "page",
              "pageSize",
              "totalItems",
              "totalPages",
              "hasNext",
              "hasPrev"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "CONFLICT",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "IDEMPOTENCY_REPLAY",
          "PROVIDER_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "description": "Field-level validation errors"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "description": "Request correlation ID for support"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateBookingInput": {
        "type": "object",
        "properties": {
          "passengerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "passengerDocument": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20,
            "description": "CPF or passport number"
          },
          "passengerEmail": {
            "type": "string",
            "format": "email"
          },
          "flightId": {
            "type": "string",
            "description": "Flight id from the search results"
          },
          "airline": {
            "type": "string"
          },
          "flightNumber": {
            "type": "string"
          },
          "originAirport": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "destinationAirport": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalAt": {
            "type": "string",
            "format": "date-time"
          },
          "cabinClass": {
            "$ref": "#/components/schemas/CabinClass"
          },
          "seatNumber": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "default": "BRL"
          },
          "providerId": {
            "type": "string",
            "format": "cuid",
            "description": "Optional linked provider for sync"
          }
        },
        "required": [
          "passengerName",
          "passengerDocument",
          "passengerEmail",
          "flightId",
          "airline",
          "flightNumber",
          "originAirport",
          "destinationAirport",
          "departureAt",
          "arrivalAt",
          "cabinClass",
          "seatNumber",
          "amountCents"
        ]
      },
      "UpdateBookingStatusInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ],
            "description": "Target status transition"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Cancellation or audit reason"
          }
        },
        "required": [
          "status"
        ]
      },
      "CabinClassOption": {
        "type": "object",
        "properties": {
          "cabinClass": {
            "$ref": "#/components/schemas/CabinClass"
          },
          "priceCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "seatsAvailable": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "cabinClass",
          "priceCents",
          "seatsAvailable"
        ]
      },
      "Flight": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Deterministic flight identifier — stable for the same search query"
          },
          "airline": {
            "type": "string"
          },
          "flightNumber": {
            "type": "string"
          },
          "originAirport": {
            "type": "string"
          },
          "originCity": {
            "type": "string"
          },
          "destinationAirport": {
            "type": "string"
          },
          "destinationCity": {
            "type": "string"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "aircraft": {
            "type": "string"
          },
          "cabinClasses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CabinClassOption"
            }
          }
        },
        "required": [
          "id",
          "airline",
          "flightNumber",
          "originAirport",
          "originCity",
          "destinationAirport",
          "destinationCity",
          "departureAt",
          "arrivalAt",
          "durationMinutes",
          "aircraft",
          "cabinClasses"
        ]
      },
      "SearchFlightsQuery": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "Origin airport IATA code, e.g. GRU"
          },
          "destination": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "Destination airport IATA code, e.g. GIG"
          },
          "departureDate": {
            "type": "string",
            "format": "date-time",
            "description": "Departure date (ISO 8601)"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "default": 1,
            "description": "Number of passengers"
          }
        },
        "required": [
          "origin",
          "destination",
          "departureDate"
        ]
      },
      "SearchFlightsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Flight"
            }
          },
          "query": {
            "$ref": "#/components/schemas/SearchFlightsQuery"
          }
        },
        "required": [
          "data",
          "query"
        ]
      },
      "SeatType": {
        "type": "string",
        "enum": [
          "WINDOW",
          "MIDDLE",
          "AISLE"
        ]
      },
      "Seat": {
        "type": "object",
        "properties": {
          "seatNumber": {
            "type": "string",
            "description": "e.g. 14C"
          },
          "row": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "seatType": {
            "$ref": "#/components/schemas/SeatType"
          },
          "cabinClass": {
            "$ref": "#/components/schemas/CabinClass"
          },
          "available": {
            "type": "boolean"
          },
          "extraFeeCents": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "seatNumber",
          "row",
          "column",
          "seatType",
          "cabinClass",
          "available"
        ]
      },
      "SeatMapResponse": {
        "type": "object",
        "properties": {
          "flightId": {
            "type": "string"
          },
          "cabinClass": {
            "$ref": "#/components/schemas/CabinClass"
          },
          "seats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Seat"
            }
          }
        },
        "required": [
          "flightId",
          "cabinClass",
          "seats"
        ]
      },
      "MockPaymentResult": {
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean"
          },
          "authorizationCode": {
            "type": "string"
          }
        },
        "required": [
          "approved",
          "authorizationCode"
        ]
      },
      "MockPaymentInput": {
        "type": "object",
        "properties": {
          "cardHolderName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "cardNumber": {
            "type": "string",
            "pattern": "^\\d{13,19}$",
            "description": "Digits only — validated for shape, never persisted"
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
            "description": "MM/YY"
          },
          "cvv": {
            "type": "string",
            "pattern": "^\\d{3,4}$"
          },
          "amountCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "cardHolderName",
          "cardNumber",
          "expiry",
          "cvv",
          "amountCents"
        ]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "IntegrationType": {
        "type": "string",
        "enum": [
          "REST",
          "SOAP"
        ]
      },
      "ProviderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "integrationType": {
            "$ref": "#/components/schemas/IntegrationType"
          },
          "baseUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "active": {
            "type": "boolean"
          },
          "lastHealthAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastHealthStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "UP",
              "DOWN",
              "UNKNOWN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "integrationType",
          "baseUrl",
          "active",
          "lastHealthAt",
          "lastHealthStatus",
          "createdAt"
        ]
      },
      "ProviderListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderResponse"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "CreateProviderInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Provider display name"
          },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9-]+$",
            "description": "URL-safe unique slug"
          },
          "integrationType": {
            "$ref": "#/components/schemas/IntegrationType"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Base URL for REST integrations"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "slug",
          "integrationType"
        ]
      },
      "SyncJobStatus": {
        "type": "string",
        "enum": [
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED"
        ]
      },
      "SyncJobResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "bookingId": {
            "type": "string",
            "format": "cuid"
          },
          "providerId": {
            "type": "string",
            "format": "cuid"
          },
          "status": {
            "$ref": "#/components/schemas/SyncJobStatus"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "bookingId",
          "providerId",
          "status",
          "attempts",
          "lastError",
          "createdAt",
          "completedAt"
        ]
      },
      "CreateSyncJobInput": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "cuid",
            "description": "Booking to sync with provider"
          },
          "providerId": {
            "type": "string",
            "format": "cuid",
            "description": "Target provider"
          }
        },
        "required": [
          "bookingId",
          "providerId"
        ]
      },
      "ProviderWebhookPayload": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "booking.confirmed",
              "booking.cancelled"
            ],
            "description": "Webhook event type"
          },
          "reference": {
            "type": "string",
            "pattern": "^BK-[A-Z0-9]{8}$",
            "description": "Booking reference in TripSync"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "providerSlug": {
            "type": "string",
            "description": "Source provider slug"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "event",
          "reference",
          "status",
          "providerSlug",
          "occurredAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "get": {
        "summary": "List bookings",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/BookingStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated booking list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create booking",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
