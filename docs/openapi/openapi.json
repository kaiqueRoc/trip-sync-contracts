{
  "openapi": "3.1.0",
  "info": {
    "title": "TripSync API",
    "version": "1.1.0",
    "description": "Travel B2B integration API — schema-first contracts from Zod (@trip-sync/contracts).",
    "contact": {
      "name": "Kaique Rocha",
      "url": "https://github.com/kaiqueRoc"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Local development"
    },
    {
      "url": "https://api.example.tripsync.dev",
      "description": "Staging (placeholder)"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and metadata"
    },
    {
      "name": "Bookings",
      "description": "Reservation lifecycle"
    },
    {
      "name": "Offers",
      "description": "Mocked availability search"
    },
    {
      "name": "Providers",
      "description": "REST/SOAP integration partners"
    },
    {
      "name": "Sync",
      "description": "Async provider synchronization"
    },
    {
      "name": "Webhooks",
      "description": "Inbound provider events"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string",
            "description": "API semantic version"
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "skipped"
                ]
              }
            },
            "required": [
              "database",
              "redis"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checks"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "CONFIRMED",
          "CANCELLED"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "reference": {
            "type": "string",
            "pattern": "^BK-[A-Z0-9]{8}$",
            "description": "Human-readable booking reference"
          },
          "travelerName": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "checkIn": {
            "type": "string",
            "format": "date-time"
          },
          "checkOut": {
            "type": "string",
            "format": "date-time"
          },
          "amountCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "providerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "cuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reference",
          "travelerName",
          "destination",
          "checkIn",
          "checkOut",
          "amountCents",
          "currency",
          "status",
          "providerId",
          "createdAt",
          "updatedAt"
        ]
      },
      "BookingListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingResponse"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "pageSize": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "totalItems": {
                "type": "integer",
                "minimum": 0
              },
              "totalPages": {
                "type": "integer",
                "minimum": 0
              },
              "hasNext": {
                "type": "boolean"
              },
              "hasPrev": {
                "type": "boolean"
              }
            },
            "required": [
              "page",
              "pageSize",
              "totalItems",
              "totalPages",
              "hasNext",
              "hasPrev"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "CONFLICT",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "IDEMPOTENCY_REPLAY",
          "PROVIDER_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "description": "Field-level validation errors"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "description": "Request correlation ID for support"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateBookingInput": {
        "type": "object",
        "properties": {
          "travelerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Full name of the traveler"
          },
          "destination": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "City or destination label"
          },
          "checkIn": {
            "type": "string",
            "format": "date-time",
            "description": "Check-in date (ISO 8601)"
          },
          "checkOut": {
            "type": "string",
            "format": "date-time",
            "description": "Check-out date (ISO 8601)"
          },
          "amountCents": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Total amount in cents"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "default": "BRL",
            "description": "ISO 4217 currency code"
          },
          "providerId": {
            "type": "string",
            "format": "cuid",
            "description": "Optional linked provider for sync"
          }
        },
        "required": [
          "travelerName",
          "destination",
          "checkIn",
          "checkOut",
          "amountCents"
        ]
      },
      "UpdateBookingStatusInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ],
            "description": "Target status transition"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Cancellation or audit reason"
          }
        },
        "required": [
          "status"
        ]
      },
      "Offer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Deterministic offer identifier — stable for the same search query"
          },
          "destination": {
            "type": "string"
          },
          "providerName": {
            "type": "string",
            "description": "Mocked hotel/pousada name"
          },
          "roomType": {
            "type": "string"
          },
          "nights": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "pricePerNightCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "totalAmountCents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "default": "BRL"
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "destination",
          "providerName",
          "roomType",
          "nights",
          "pricePerNightCents",
          "totalAmountCents",
          "rating",
          "amenities"
        ]
      },
      "SearchOffersQuery": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "City or destination label"
          },
          "checkIn": {
            "type": "string",
            "format": "date-time",
            "description": "Check-in date (ISO 8601)"
          },
          "checkOut": {
            "type": "string",
            "format": "date-time",
            "description": "Check-out date (ISO 8601)"
          },
          "travelers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "default": 1,
            "description": "Number of travelers"
          }
        },
        "required": [
          "destination",
          "checkIn",
          "checkOut"
        ]
      },
      "SearchOffersResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "query": {
            "$ref": "#/components/schemas/SearchOffersQuery"
          }
        },
        "required": [
          "data",
          "query"
        ]
      },
      "IntegrationType": {
        "type": "string",
        "enum": [
          "REST",
          "SOAP"
        ]
      },
      "ProviderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "integrationType": {
            "$ref": "#/components/schemas/IntegrationType"
          },
          "baseUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "active": {
            "type": "boolean"
          },
          "lastHealthAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastHealthStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "UP",
              "DOWN",
              "UNKNOWN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "integrationType",
          "baseUrl",
          "active",
          "lastHealthAt",
          "lastHealthStatus",
          "createdAt"
        ]
      },
      "ProviderListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderResponse"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "CreateProviderInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Provider display name"
          },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9-]+$",
            "description": "URL-safe unique slug"
          },
          "integrationType": {
            "$ref": "#/components/schemas/IntegrationType"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Base URL for REST integrations"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "slug",
          "integrationType"
        ]
      },
      "SyncJobStatus": {
        "type": "string",
        "enum": [
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED"
        ]
      },
      "SyncJobResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "cuid"
          },
          "bookingId": {
            "type": "string",
            "format": "cuid"
          },
          "providerId": {
            "type": "string",
            "format": "cuid"
          },
          "status": {
            "$ref": "#/components/schemas/SyncJobStatus"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "bookingId",
          "providerId",
          "status",
          "attempts",
          "lastError",
          "createdAt",
          "completedAt"
        ]
      },
      "CreateSyncJobInput": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "cuid",
            "description": "Booking to sync with provider"
          },
          "providerId": {
            "type": "string",
            "format": "cuid",
            "description": "Target provider"
          }
        },
        "required": [
          "bookingId",
          "providerId"
        ]
      },
      "ProviderWebhookPayload": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "booking.confirmed",
              "booking.cancelled"
            ],
            "description": "Webhook event type"
          },
          "reference": {
            "type": "string",
            "pattern": "^BK-[A-Z0-9]{8}$",
            "description": "Booking reference in TripSync"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "providerSlug": {
            "type": "string",
            "description": "Source provider slug"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "event",
          "reference",
          "status",
          "providerSlug",
          "occurredAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "get": {
        "summary": "List bookings",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/BookingStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by destination (partial match)"
            },
            "required": false,
            "description": "Filter by destination (partial match)",
            "name": "destination",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "cuid"
            },
            "required": false,
            "name": "providerId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated booking list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create booking",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Optional idempotency key for safe retries"
            },
            "required": false,
            "description": "Optional idempotency key for safe retries",
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict / idempotency replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "summary": "Get booking by ID",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "cuid",
              "description": "Booking unique identifier"
            },
            "required": true,
            "description": "Booking unique identifier",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/{id}/status": {
      "patch": {
        "summary": "Update booking status",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "cuid",
              "description": "Booking unique identifier"
            },
            "required": true,
            "description": "Booking unique identifier",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookingStatusInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict / idempotency replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/offers/search": {
      "get": {
        "summary": "Search mocked availability offers",
        "tags": [
          "Offers"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "City or destination label"
            },
            "required": true,
            "description": "City or destination label",
            "name": "destination",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Check-in date (ISO 8601)"
            },
            "required": true,
            "description": "Check-in date (ISO 8601)",
            "name": "checkIn",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Check-out date (ISO 8601)"
            },
            "required": true,
            "description": "Check-out date (ISO 8601)",
            "name": "checkOut",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "default": 1,
              "description": "Number of travelers"
            },
            "required": false,
            "description": "Number of travelers",
            "name": "travelers",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Mocked offer results — deterministic per query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOffersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
